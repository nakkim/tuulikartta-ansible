# Managed by Ansible. Do not edit on the server.
# TLS and HTTP -> HTTPS redirect are handled by the Hetzner load balancer,
# which forwards plain HTTP to this server on port 80.
server {
    listen 80;
    listen [::]:80;
    server_name {{ nginx_server_names | join(' ') }};

    # Real client IP from the load balancer's X-Forwarded-For
{% for proxy in nginx_trusted_proxies %}
    set_real_ip_from {{ proxy }};
{% endfor %}
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

{% if nginx_geoserver_upstream is defined %}
    # GeoServer WMS/WMTS. The geoserver-proxy container decides which paths are allowed.
    location /geoserver/ {
        proxy_pass         http://{{ nginx_geoserver_upstream }};
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $remote_addr;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_read_timeout 70s;
    }

{% endif %}
    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
